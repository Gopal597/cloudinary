<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  </head>
  <body>
    <div class="container mt-4">
      <h1 style="margin: 10px 0px 15px">🗑️ Recycle Bin</h1>
      
      <!-- Navigation Back to Main Product Catalogue -->
      <div class="mb-3">
        <a href="/products" class="btn btn-outline-secondary">Back to Active Products</a>
      </div>

      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th scope="col">SL. No</th>
            <th scope="col">ID</th>
            <th scope="col">Name</th>
            <th scope="col">Price</th>
            <th scope="col">Brand</th>
            <th scope="col">Description</th>
            <th scope="col">Image</th>
            <th scope="col" class="text-center" colspan="2">Action</th>
          </tr>
        </thead>
        
        <tbody>
          <% if (products.length === 0) { %>
            <tr>
              <td colspan="9" class="text-center text-muted py-4">
                Your Recycle Bin is empty.
              </td>
            </tr>
          <% } else { %>
            <% let sl = 1; %>
            <% for(let product of products){ %>
              <tr>
                <th scope="row"><%= sl %></th>
                <td><%= product._id.toString().slice(-5) %></td>
                <td><%= product.name %></td>
                <td>₹<%= product.price %></td>
                <td><%= product.brand %></td>
                <td><%= product.description %></td>
                <td>
                  <img
                    src="<%= product.image %>"
                    alt="Deleted Product Image"
                    style="width: 50px; height: 50px; object-fit: cover; border-radius: 50%;"
                  />
                </td>
                
                <!-- Action Buttons -->
                <td>
                  <!-- Restore Route Action -->
                  <a href="/restore/products/<%= product._id %>" class="btn btn-sm btn-outline-success">Restore</a>
                </td>
                <td>
                  <!-- Hard/Permanent Delete Route Action -->
                  <a href="/delete/products/<%= product._id %>" 
                     class="btn btn-sm btn-outline-danger" 
                     onclick="return confirm('Warning: This will permanently wipe this product from your database. Are you sure?')">
                     Delete Permanently
                  </a>
                </td>
              </tr>
              <% sl++ %>
            <% } %>
          <% } %>
        </tbody>
      </table>
    </div>
    
    <script src="https://jsdelivr.net" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  </body>
</html>
